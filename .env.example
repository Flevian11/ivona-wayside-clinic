APP_NAME="Ivona Wayside Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ivonawaysidemed.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL database configuration
# Confirm PostgreSQL is enabled for this cPanel account.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ivonaway_iwc
DB_USERNAME=ivonaway_ict
DB_PASSWORD=

# Session configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ivonawaysidemed.co.ke
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Application services
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email configuration
# Replace with your actual cPanel email/SMTP details.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# AWS / cloud storage - optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HMIS integration
IWC_INTEGRATION_ENVIRONMENT=production
IWC_INTEGRATION_TIMEOUT=20
IWC_INTEGRATION_CONNECT_TIMEOUT=5
IWC_INTEGRATION_MOCK_SEED=ivona-wayside-clinic-production

# WHO ICD-11 terminology API
WHO_ICD11_CLIENT_ID=
WHO_ICD11_CLIENT_SECRET=
WHO_ICD11_RELEASE=2025-01