import { useState } from 'react';import { useForm } from '@inertiajs/react';import { Save, ShieldCheck } from 'lucide-react';import { Button } from '@/components/ui/button';import { Label } from '@/components/ui/label';import { DevToolsShell,Panel,Notice,inputClass } from './_shared';
type Environment={environment:string;base_url:string|null;token_url:string|null;auth_method:string;client_id:string|null;has_client_secret:boolean;scopes:string[];enabled:boolean;agent_id:string|null;facility_id:string|null;facility_id_type:string|null;has_password:boolean;has_consumer_secret:boolean;has_private_key:boolean;has_public_key:boolean;has_provider_public_key:boolean;has_client_certificate:boolean;has_client_certificate_key:boolean;endpoint_map:Record<string,string>;encrypted_operations:string[];verify_tls:boolean};type Integration={id:number;name:string;slug:string;provider:string;status:string;environments:Environment[]};type Props={activeEnvironment:string;canManage:boolean;integration:Integration;environmentOptions:string[];flash?:{success?:string}};
const labelClass='grid gap-2';
export default function Environments({activeEnvironment,canManage,integration,environmentOptions,flash}:Props){const [selected,setSelected]=useState(activeEnvironment);const current=integration.environments.find(e=>e.environment===selected);const form=useForm({environment:selected,base_url:current?.base_url??'',token_url:current?.token_url??'',auth_method:current?.auth_method??'oauth2_client_credentials',client_id:current?.client_id??'',client_secret:'',scopes_text:(current?.scopes??[]).join(', '),enabled:current?.enabled??false,agent_id:current?.agent_id??'',facility_id:current?.facility_id??'',facility_id_type:current?.facility_id_type??'',username:'',password:'',consumer_key:'',consumer_secret:'',private_key:'',public_key:'',provider_public_key:'',client_certificate:'',client_certificate_key:'',callback_url:'',validation_url:'',endpoint_map_text:Object.entries(current?.endpoint_map??{}).map(([k,v])=>`${k}=${v}`).join('\n'),encrypted_operations_text:(current?.encrypted_operations??[]).join(', '),verify_tls:current?.verify_tls??true});const changeEnvironment=(env:string)=>{setSelected(env);const e=integration.environments.find(x=>x.environment===env);form.setData({...form.data,environment:env,base_url:e?.base_url??'',token_url:e?.token_url??'',auth_method:e?.auth_method??'oauth2_client_credentials',client_id:e?.client_id??'',client_secret:'',scopes_text:(e?.scopes??[]).join(', '),enabled:e?.enabled??false,agent_id:e?.agent_id??'',facility_id:e?.facility_id??'',facility_id_type:e?.facility_id_type??'',password:'',consumer_secret:'',private_key:'',public_key:'',provider_public_key:'',client_certificate:'',client_certificate_key:'',endpoint_map_text:Object.entries(e?.endpoint_map??{}).map(([k,v])=>`${k}=${v}`).join('\n'),encrypted_operations_text:(e?.encrypted_operations??[]).join(', '),verify_tls:e?.verify_tls??true})};const save=(event:React.FormEvent)=>{event.preventDefault();const endpoint_map:Record<string,string>={};form.data.endpoint_map_text.split(/\r?\n/).forEach(line=>{const index=line.indexOf('=');if(index>0)endpoint_map[line.slice(0,index).trim()]=line.slice(index+1).trim()});form.transform(data=>({...data,scopes:data.scopes_text.split(',').map(s=>s.trim()).filter(Boolean),endpoint_map,encrypted_operations:data.encrypted_operations_text.split(',').map(s=>s.trim()).filter(Boolean)}));form.put(`/developer-tools/integrations/${integration.id}/environments`,{preserveScroll:true,onFinish:()=>form.transform(data=>data)})};return <DevToolsShell title="Environment settings" description={`Separate endpoints and credentials for ${integration.name}. Switching this editor only changes which configuration you are editing; the running application mode is set on the server.`} environment={activeEnvironment}>{flash?.success&&<Notice>{flash.success}</Notice>}<Panel title="Choose an environment" description="Save each environment independently. Development is mock-only at runtime; UAT and Production make real calls only when their profile and provider are enabled."><div className="grid gap-3 sm:grid-cols-3">{environmentOptions.map(env=><button type="button" key={env} onClick={()=>changeEnvironment(env)} className={`rounded-xl border p-4 text-left transition-colors ${selected===env?'border-primary bg-primary/5':'hover:bg-muted/50'}`}><p className="font-semibold capitalize">{env}</p><p className="mt-1 text-xs text-muted-foreground">{integration.environments.find(e=>e.environment===env)?.enabled?'Configured and enabled':'Disabled or not configured'}</p></button>)}</div></Panel><Panel title={`${selected.toUpperCase()} connection details`} description="Never paste credentials into notes. Secret inputs are write-only; leave a secret blank to preserve the stored value.">{canManage?<form onSubmit={save} className="grid gap-5 md:grid-cols-2"><input type="hidden" value={form.data.environment}/><div className={labelClass}><Label>API base URL</Label><input className={inputClass} type="url" value={form.data.base_url} onChange={e=>form.setData('base_url',e.target.value)} placeholder="Exact provider-issued base URL"/></div><div className={labelClass}><Label>OAuth / token URL</Label><input className={inputClass} type="url" value={form.data.token_url} onChange={e=>form.setData('token_url',e.target.value)} placeholder="Exact documented token endpoint"/></div><div className={labelClass}><Label>Authentication method</Label><select className={inputClass} value={form.data.auth_method} onChange={e=>form.setData('auth_method',e.target.value)}><option value="oauth2_client_credentials">OAuth 2.0 client credentials</option><option value="afyalink_configured_bearer">AfyaLink account-issued token</option><option value="afyalink_signed_jwt">AfyaLink signed JWT</option><option value="api_key">API key</option><option value="basic">HTTP Basic</option><option value="none">No authentication</option></select></div><div className={labelClass}><Label>Client ID / username</Label><input className={inputClass} value={form.data.client_id} onChange={e=>form.setData('client_id',e.target.value)} autoComplete="off"/></div><div className={labelClass}><Label>Client secret {current?.has_client_secret?'(saved; blank preserves it)':''}</Label><input className={inputClass} type="password" value={form.data.client_secret} onChange={e=>form.setData('client_secret',e.target.value)} autoComplete="new-password"/></div><div className={labelClass}><Label>Scopes (exact provider-issued values)</Label><input className={inputClass} value={form.data.scopes_text} onChange={e=>form.setData('scopes_text',e.target.value)} placeholder="Comma-separated exact scopes"/></div><div className={labelClass}><Label>Facility identifier</Label><input className={inputClass} value={form.data.facility_id} onChange={e=>form.setData('facility_id',e.target.value)}/></div><div className={labelClass}><Label>Facility identifier type</Label><input className={inputClass} value={form.data.facility_id_type} onChange={e=>form.setData('facility_id_type',e.target.value)} placeholder="As required by the API specification"/></div><div className={labelClass}><Label>Agent / provider-issued identifier</Label><input className={inputClass} value={form.data.agent_id} onChange={e=>form.setData('agent_id',e.target.value)}/></div><div className={labelClass}><Label>Basic-auth password (if required) {current?.has_password?'(saved)':''}</Label><input className={inputClass} type="password" value={form.data.password} onChange={e=>form.setData('password',e.target.value)}/></div><div className={labelClass}><Label>Consumer key (AfyaLink, if issued)</Label><input className={inputClass} value={form.data.consumer_key} onChange={e=>form.setData('consumer_key',e.target.value)}/></div><div className={labelClass}><Label>Consumer secret {current?.has_consumer_secret?'(saved)':''}</Label><input className={inputClass} type="password" value={form.data.consumer_secret} onChange={e=>form.setData('consumer_secret',e.target.value)}/></div>{[['private_key','Clinic private key',current?.has_private_key],['public_key','Clinic public key',current?.has_public_key],['provider_public_key','Provider public key',current?.has_provider_public_key],['client_certificate','Client certificate',current?.has_client_certificate],['client_certificate_key','Client certificate private key',current?.has_client_certificate_key]].map(([key,title,exists])=><div key={String(key)} className={`${labelClass} md:col-span-2`}><Label>{title}{exists?' (saved; blank preserves it)':''}</Label><textarea className={`${inputClass} min-h-24 font-mono text-xs`} value={(form.data as any)[key]} onChange={e=>form.setData(key as any,e.target.value)} placeholder="Paste only the provider-issued value for this environment"/></div>)}<div className={`${labelClass} md:col-span-2`}><Label>Operation endpoint map</Label><textarea className={`${inputClass} min-h-36 font-mono text-xs`} value={form.data.endpoint_map_text} onChange={e=>form.setData('endpoint_map_text',e.target.value)} placeholder={'eligibility.check=/patients/eligibility\npatient.benefits=/patients/benefits'}/><p className="text-xs text-muted-foreground">One operation=path per line. Use only paths documented for this exact API product.</p></div><div className={labelClass}><Label>Operations requiring encrypted payloads</Label><input className={inputClass} value={form.data.encrypted_operations_text} onChange={e=>form.setData('encrypted_operations_text',e.target.value)} placeholder="Comma-separated operation names"/></div><div className={labelClass}><Label>Callback URL (if required)</Label><input className={inputClass} type="url" value={form.data.callback_url} onChange={e=>form.setData('callback_url',e.target.value)}/></div><div className={labelClass}><Label>Validation URL (if required)</Label><input className={inputClass} type="url" value={form.data.validation_url} onChange={e=>form.setData('validation_url',e.target.value)}/></div><label className="flex items-center gap-3 rounded-lg border p-3"><input type="checkbox" checked={form.data.enabled} onChange={e=>form.setData('enabled',e.target.checked)}/><span><span className="block text-sm font-medium">Enable this environment profile</span><span className="block text-xs text-muted-foreground">Production also requires the provider profile to be enabled and approved.</span></span></label><label className="flex items-center gap-3 rounded-lg border p-3"><input type="checkbox" checked={form.data.verify_tls} onChange={e=>form.setData('verify_tls',e.target.checked)}/><span><span className="block text-sm font-medium">Verify TLS certificates</span><span className="block text-xs text-muted-foreground">Mandatory for UAT and Production.</span></span></label><div className="md:col-span-2"><Button disabled={form.processing}><Save className="mr-2 size-4"/>Save {selected.toUpperCase()} settings</Button></div></form>:<Notice>You have read-only access to these settings.</Notice>}</Panel><Notice><ShieldCheck className="mr-2 inline size-4"/>Environment settings are used by the shared HMIS integration gateway. Individual patient, billing and claims modules should not store separate credentials or bypass this gateway.</Notice></DevToolsShell>}
